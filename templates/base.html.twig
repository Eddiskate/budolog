<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site_name }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Poradniki budowlane i kalkulatory — ocieplenie, beton, fotowoltaika. Licz koszty zanim zadzwonisz po ekipę.{% endblock %}">
    <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ site_url }}{{ app.request.pathInfo }}{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css?v=2">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230F172A'/%3E%3Cpath d='M8 22V10h4l4 8 4-8h4v12h-3.2v-7.2L17.5 22h-3L11.2 14.8V22H8z' fill='%23EA580C'/%3E%3C/svg%3E">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0LL1M914Q7"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0LL1M914Q7');
    </script>
    {% block head %}{% endblock %}
</head>
<body>
    <div class="page-bg" aria-hidden="true"></div>
    <header class="site-header">
        <a class="brand" href="{{ path('app_home') }}">{{ site_name }}</a>
        <nav class="nav" aria-label="Główne">
            <a href="{{ path('app_guides') }}">Poradniki</a>
            <a href="{{ path('app_articles') }}">Artykuły</a>
            <a href="{{ path('app_calculators') }}">Kalkulatory</a>
            <a href="{{ path('app_about') }}">O nas</a>
            <a class="nav-cta" href="{{ path('app_calc_insulation') }}">Policz ocieplenie</a>
        </nav>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <p class="disclosure">Część linków na stronie to linki partnerskie. Jeśli coś kupisz przez taki link, możemy otrzymać prowizję — Ty nie dopłacasz. Szacunki w kalkulatorach są orientacyjne.</p>
        <div class="footer-row">
            <span>&copy; {{ "now"|date("Y") }} {{ site_name }}</span>
            <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
        </div>
    </footer>
    {% block scripts %}{% endblock %}
</body>
</html>
